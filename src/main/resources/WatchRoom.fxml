<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #0f172a;" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cinemates.controller.WatchRoomController">
    <center>
        <BorderPane style="-fx-background-color: black;">
            <center>
                <StackPane>
                    <MediaView fx:id="watchMediaView" fitHeight="600.0" fitWidth="900.0" preserveRatio="true" />
                </StackPane>
            </center>
            <bottom>
                <VBox alignment="BOTTOM_CENTER" spacing="10.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="40.0" right="40.0" top="10.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Label fx:id="lblCurrentTime" text="00:00" textFill="WHITE">
                                    <font><Font name="System Monospaced" size="12.0" /></font>
                                </Label>
                                <Slider fx:id="sliderProgress" HBox.hgrow="ALWAYS" styleClass="video-slider" />
                                <Label fx:id="lblTotalTime" text="00:00" textFill="WHITE">
                                    <font><Font name="System Monospaced" size="12.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="room-code-pill">
                                <children>
                                    <Label text="Mã phòng:" textFill="#999" />
                                    <Label fx:id="lblRoomCode" minWidth="120.0" text="CIN-LOADING..." textFill="WHITE">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Button onAction="#handleCopyCode" styleClass="btn-copy-mini" text="📋" />
                                </children>
                                <padding>
                                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                                </padding>
                            </HBox>

                            <HBox alignment="CENTER" spacing="15.0" styleClass="meet-control-bar" HBox.hgrow="ALWAYS">
                                <children>
                                    <Button fx:id="btnMicrophone" onAction="#handleToggleMicrophone" styleClass="btn-meet-icon" text="🎤" />
                                    <Button fx:id="btnVolume" onAction="#handleToggleVolume" styleClass="btn-meet-icon" text="🔊" />

                                    <Button onAction="#handleRewind" styleClass="btn-meet-icon" text="⏪" />

                                    <Button fx:id="btnPlayPause" onAction="#handleTogglePlay" styleClass="btn-meet-play" text="⏸" />

                                    <Button onAction="#handleForward" styleClass="btn-meet-icon" text="⏩" />

                                    <Button styleClass="btn-meet-icon" text="💬" />
                                    <Button onAction="#handleLeaveRoom" styleClass="btn-meet-leave" text="📞 Rời phòng" />
                                </children>
                                <padding>
                                    <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                                </padding>
                            </HBox>
                        </HBox>
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </center>

    <right>
        <VBox prefWidth="320.0" style="-fx-background-color: #1e293b;">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0">
                    <children>
                        <Label text="Chi tiết phòng" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleLeaveRoom" style="-fx-text-fill: white; -fx-background-color: transparent;" text="✕" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </HBox>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Nhắn tin">
                            <content>
                                <VBox spacing="10.0">
                                    <children>
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="meet-chat-scroll" VBox.vgrow="ALWAYS">
                                            <content>
                                                <VBox fx:id="vboxChatMessages" spacing="10.0" style="-fx-padding: 15;" />
                                            </content>
                                        </ScrollPane>
                                        <HBox spacing="10.0" styleClass="meet-input-container">
                                            <children>
                                                <TextField fx:id="txtChatMessage" onAction="#handleSendMessage" promptText="Gửi tin nhắn..." styleClass="meet-input" HBox.hgrow="ALWAYS" />
                                                <Button onAction="#handleSendMessage" styleClass="btn-send-mini" text="✈" />
                                            </children>
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
                                            </padding>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Mọi người">
                            <content>
                                <VBox fx:id="vboxParticipants" spacing="15.0" style="-fx-padding: 20;" />
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </right>
</BorderPane>